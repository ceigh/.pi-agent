{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "permissionReviewLog": false,
  "permission": {
    "*": "allow",
    "path_read": {
      ".env*": "deny",
      "*/.env*": "deny",
      ".admin-token": "deny",
      "*/.admin-token": "deny"
    },
    "edit": {
      "*": "allow",
      "*/backend/*": "deny"
    },
    "bash": {
      "*": "allow",
      "*--headless*": "deny",
      "rm *backend*": "deny",
      "sed -i *backend*": "deny",
      "bunx *": "deny",
      "bun dev *": "deny",
      "bun run dev *": "deny",
      "bun --watch *": "deny",
      "bun --hot *": "deny",
      "playwright *": "deny",
      "bun *nuxt dev*": "deny",
      "bun install *": "deny",
      "bun add *": "deny",
      "bun remove *": "deny",
      "bun update *": "deny",
      "npx": "deny",
      "npx *": "deny",
      "yarn": "deny",
      "yarn install": "deny",
      "yarn install *": "deny",
      "yarn add": "deny",
      "yarn add *": "deny",
      "yarn remove": "deny",
      "yarn remove *": "deny",
      "yarn upgrade": "deny",
      "yarn upgrade *": "deny",
      "yarn dev": "deny",
      "yarn dev *": "deny",
      "yarn run dev": "deny",
      "yarn run dev *": "deny",
      "git commit": "deny",
      "git commit *": "deny",
      "git push": "deny",
      "git push *": "deny",
      "git pull": "deny",
      "git pull *": "deny",
      "git branch": "deny",
      "git branch *": "deny",
      "git checkout": "deny",
      "git checkout *": "deny",
      "git switch": "deny",
      "git switch *": "deny",
      "git merge": "deny",
      "git merge *": "deny",
      "git rebase": "deny",
      "git rebase *": "deny",
      "git reset": "deny",
      "git reset *": "deny",
      "git restore *": "deny",
      "git clean *": "deny"
    }
  }
}
